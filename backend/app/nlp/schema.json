  "relationship_patterns": {
    "AUTHORED_BY": ["\\b(?:authored|written)\\s+by\\b"],
    "USES": ["\\b(?:uses?|used|using)\\b"],
    "PROPOSES": ["\\b(?:proposes?|introduces?|presents?)\\b"],
    "EVALUATES_ON": ["\\b(?:evaluates?|evaluated)\\s+on\\b"],
    "MEASURED_BY": ["\\bmeasured\\s+(?:by|using)\\b"],
    "ADDRESSES": ["\\baddresses?\\b"],
    "RELATED_TO": ["\\brelated\\s+to\\b", "\\b(?:connects?|links?)\\b"],
    "PART_OF": ["\\bpart\\s+of\\b"],
    "DEPENDS_ON": ["\\b(?:depends?|dependent)\\s+on\\b"],
    "REPORTS": ["\\b(?:reports?|finds?|shows?|demonstrates?)\\b"],
    "COMPARES_WITH": ["\\bcompares?\\s+(?:with|to)\\b"]
  }
}
