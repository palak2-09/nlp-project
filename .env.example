# PaperGraph AI backend settings
# Copy this file to .env. For local development, SQLite is the no-service default.
PAPERGRAPH_DATA_DIR=./data
PAPERGRAPH_MAX_UPLOAD_BYTES=26214400
PAPERGRAPH_CHUNK_SIZE_CHARS=1200
PAPERGRAPH_CHUNK_OVERLAP_CHARS=120
PAPERGRAPH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
PAPERGRAPH_MIN_EXTRACTION_CONFIDENCE=0.0
PAPERGRAPH_GRAPH_MAX_NODES=250
PAPERGRAPH_ANNOTATIONS_PATH=data/annotations/gold.jsonl

# Graph persistence
# Use sqlite for local development. For Aura/external Neo4j, set this to neo4j
# and copy URI, username, password, and database exactly from the provider details.
# Docker Compose sets its own local Neo4j target when you run the compose stack.
PAPERGRAPH_GRAPH_BACKEND=sqlite
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j

# Optional semantic search/entity similarity (requires backend/requirements-ml.txt
# and a first-run download of the model; leave false for the lightweight baseline).
PAPERGRAPH_ENABLE_EMBEDDINGS=false
PAPERGRAPH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERGRAPH_ENTITY_MATCH_THRESHOLD=0.93
PAPERGRAPH_ENTITY_REVIEW_THRESHOLD=0.78

# Optional structured LLM extraction and answer generation.
# Leave provider=none for offline rule-based extraction and retrieval-only answers.
# To use Gemini, set provider=gemini, add your Google AI Studio API key below, and select a Gemini model.
# For an OpenAI-compatible service, set provider=openai_compatible and configure its base URL and model.
PAPERGRAPH_LLM_PROVIDER=none
# Used only by the openai_compatible provider.
PAPERGRAPH_LLM_BASE_URL=https://api.openai.com/v1
# The same key setting is used for Gemini or an OpenAI-compatible provider.
PAPERGRAPH_LLM_API_KEY=
PAPERGRAPH_LLM_MODEL=gemini-3.8-flash
PAPERGRAPH_LLM_TIMEOUT_SECONDS=45
PAPERGRAPH_LLM_MAX_CHUNKS_PER_DOCUMENT=20
PAPERGRAPH_LLM_MAX_INPUT_CHARS=12000
PAPERGRAPH_LLM_MAX_OUTPUT_TOKENS=1200

# Optional custom entity/relation configuration. Relative paths are from project root.
# PAPERGRAPH_SCHEMA_PATH=backend/app/nlp/schema.json
